# 本机 Docker Compose PostgreSQL 示例；部署环境请注入自己的凭据。
DATABASE_URL=postgres://courserep:courserep-local@localhost:5433/courserep?sslmode=disable
HTTP_ADDR=:8080
# 至少 32 字节随机值；示例中留空，启动认证接口前必须由本地环境注入。
AUTH_SECRET=
# 逗号分隔的允许邮箱域名，留空时默认 my.cityu.edu.hk。
STUDENT_EMAIL_DOMAINS=my.cityu.edu.hk
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
UPLOAD_DIR=./uploads
